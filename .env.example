# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Clerk URLs (customize for your instance)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Database
DATABASE_URL="postgresql://user:password@host:5432/propati?pgbouncer=true&connection_limit=1"

# Supabase (if using Supabase directly)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Paystack — https://dashboard.paystack.com/#/settings/developers
# Secret key is server-only: transactions, transfers, dedicated accounts and
# webhook HMAC verification. Paystack signs webhooks with this key, so there is
# no separate webhook secret to configure.
PAYSTACK_SECRET_KEY=sk_test_your_key
# Public key is safe in the browser (inline / checkout flows).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_key

# Prembly IdentityPass
PREMBLY_API_KEY=your_api_key
PREMBLY_APP_ID=your_app_id

# Termii (SMS)
TERMII_API_KEY=your_api_key
TERMII_SENDER_ID=PROPATI

# NIPOST Postcode API — address validation
# https://docs.postcode.gov.ng
NIPOST_API_KEY=your_api_key

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+1...<SECRET_b90fe98a>%s    # use env var in code, never commit real value

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Resend)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=PROPATI <noreply@propati.ng>
EMAIL_FROM=PROPATI <noreply@propati.ng>

# Email (Legacy SMTP — Nodemailer, deprecated)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=PROPATI <noreply@propati.ng>

# Remita (Stamp Duty remittance / e-Certificate)
# https://remita.net — merchant credentials come from your Remita onboarding.
REMITA_MERCHANT_ID=
REMITA_API_KEY=
REMITA_BASE_URL=https://remitademo.net

# One Remita service type per collecting authority. Duty is routed by the
# agreement's state: Lagos -> LIRS, FCT -> FIRS, every other state -> SIRS.
REMITA_SERVICE_TYPE_FIRS=
REMITA_SERVICE_TYPE_LIRS=
REMITA_SERVICE_TYPE_SIRS=
# Fallback used when an authority-specific service type is not set.
REMITA_SERVICE_TYPE_ID=4430731

# Stamp duty rates are configurable per instrument so counsel can adjust them
# without a code change. Leave unset to use the statutory defaults.
# STAMP_DUTY_RATE_RESIDENTIAL_TENANCY=0.0078
# STAMP_DUTY_BASIS_RESIDENTIAL_TENANCY=annual_rent
# STAMP_DUTY_RATE_COMMERCIAL_LEASE=0.0078
# STAMP_DUTY_BASIS_COMMERCIAL_LEASE=total_term_consideration
# STAMP_DUTY_RATE_SHORT_LET=0.0078
# STAMP_DUTY_RATE_SALE_CONVEYANCE=0.015
# STAMP_DUTY_THRESHOLD_COMMERCIAL_LEASE=10000
# STAMP_DUTY_MINIMUM_COMMERCIAL_LEASE=500

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Dojah Identity Verification
NEXT_PUBLIC_DOJAH_APP_ID=your_dojah_app_id
NEXT_PUBLIC_DOJAH_PUBLIC_KEY=your_dojah_public_key
NEXT_PUBLIC_DOJAH_WIDGET_ID=your_dojah_widget_id
DOJAH_SECRET_KEY=your_dojah_secret_key
DOJAH_BASE_URL=https://api.dojah.io