// ===========================================================================
// PROPATI — Prisma Schema for PostgreSQL (Supabase)
// Source: DATABASE_SCHEMA.md
// Generated for Next.js 14 + Prisma
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum UserRole {
  landlord
  tenant
  agent
  admin
  estate_manager
}

enum ListingType {
  rent
  sale
  short_let
  share
  commercial
}

enum PropertyType {
  apartment
  house
  duplex
  land
  office
  shop
  warehouse
}

enum ListingStatus {
  draft
  active
  suspended
  deleted
}

enum ShortletStatus {
  pending
  approved
  rejected
  revoked
  withdrawn
}

enum VerificationTier {
  basic
  verified
  inspected
  certified
}

enum VerificationLayerStatus {
  pending
  approved
  rejected
}

enum VerificationOverallStatus {
  not_started
  in_progress
  certified
  rejected
  frozen
}

enum TransactionType {
  rent
  caution
  sale
  short_let
  subscription
}

enum TransactionStatus {
